description="The D-Bus GLib package contains GLib interfaces to the D-Bus API."
url="http://www.freedesktop.org/wiki/Software/DBusBindings"

packager="spiky <spiky@nutyx.org>"

makedepends=(git autoconf m4 dbus expat glib gtk-doc)

name=dbus-glib
version=0.116
tag=$name-$version
source=(https://gitlab.freedesktop.org/dbus/${name}.git)

prepare() {
cd $name-$version
autoreconf -fiv
}

build() {
cd $name-$version
./configure --prefix=/usr \
--disable-static \
--sysconfdir=/etc
make
make DESTDIR=$PKG install
rm $PKG/usr/lib/libdbus-glib-1.la
}
