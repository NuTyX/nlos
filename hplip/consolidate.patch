+	@$(NORMAL_UNINSTALL)
+	@list='$(dist_plugins5_SCRIPTS)'; test -n "$(plugins5dir)" || exit 0; \
+	files=`for p in $$list; do echo "$$p"; done | \
+	       sed -e 's,.*/,,;$(transform)'`; \
+	dir='$(DESTDIR)$(plugins5dir)'; $(am__uninstall_files_from_dir)
