+install-cupsextLTLIBRARIES: $(cupsext_LTLIBRARIES)
+	@$(NORMAL_INSTALL)
+	@list='$(cupsext_LTLIBRARIES)'; test -n "$(cupsextdir)" || list=; \
+	list2=; for p in $$list; do \
+	  if test -f $$p; then \
+	    list2="$$list2 $$p"; \
+	  else :; fi; \
+	done; \
+	test -z "$$list2" || { \
+	  echo " $(MKDIR_P) '$(DESTDIR)$(cupsextdir)'"; \
