+# --- Security hardening flags (CWE-693: Insecure Binary Protection) ---
+# Probe for each flag individually so the build still works on older toolchains.
+SECURITY_CFLAGS=""
+SECURITY_LDFLAGS=""
+AS_IF([test "x$GCC" = "xyes"], [
+  save_CFLAGS="$CFLAGS"
+  save_LDFLAGS="$LDFLAGS"
+
+  AC_MSG_CHECKING([whether gcc accepts -fstack-protector-strong])
+  CFLAGS="$save_CFLAGS -fstack-protector-strong"
+  AC_COMPILE_IFELSE([AC_LANG_PROGRAM()],
+    [SECURITY_CFLAGS="$SECURITY_CFLAGS -fstack-protector-strong"
+     AC_MSG_RESULT([yes])],
+    [AC_MSG_RESULT([no])])
+
+  AC_MSG_CHECKING([whether gcc accepts -fstack-clash-protection])
+  CFLAGS="$save_CFLAGS -fstack-clash-protection"
+  AC_COMPILE_IFELSE([AC_LANG_PROGRAM()],
+    [SECURITY_CFLAGS="$SECURITY_CFLAGS -fstack-clash-protection"
+     AC_MSG_RESULT([yes])],
+    [AC_MSG_RESULT([no])])
+
+  AC_MSG_CHECKING([whether gcc accepts -D_FORTIFY_SOURCE=2])
+  CFLAGS="$save_CFLAGS -O2 -D_FORTIFY_SOURCE=2"
+  AC_COMPILE_IFELSE([AC_LANG_PROGRAM()],
+    [SECURITY_CFLAGS="$SECURITY_CFLAGS -D_FORTIFY_SOURCE=2"
+     AC_MSG_RESULT([yes])],
+    [AC_MSG_RESULT([no])])
+
+  AC_MSG_CHECKING([whether gcc accepts -fcf-protection])
+  CFLAGS="$save_CFLAGS -fcf-protection"
+  AC_COMPILE_IFELSE([AC_LANG_PROGRAM()],
+    [SECURITY_CFLAGS="$SECURITY_CFLAGS -fcf-protection"
+     AC_MSG_RESULT([yes])],
+    [AC_MSG_RESULT([no])])
+
+  AC_MSG_CHECKING([whether linker accepts -Wl,-z,relro])
+  LDFLAGS="$save_LDFLAGS -Wl,-z,relro"
+  AC_LINK_IFELSE([AC_LANG_PROGRAM()],
+    [SECURITY_LDFLAGS="$SECURITY_LDFLAGS -Wl,-z,relro"
+     AC_MSG_RESULT([yes])],
+    [AC_MSG_RESULT([no])])
+
+  AC_MSG_CHECKING([whether linker accepts -Wl,-z,now])
+  LDFLAGS="$save_LDFLAGS -Wl,-z,now"
+  AC_LINK_IFELSE([AC_LANG_PROGRAM()],
+    [SECURITY_LDFLAGS="$SECURITY_LDFLAGS -Wl,-z,now"
+     AC_MSG_RESULT([yes])],
+    [AC_MSG_RESULT([no])])
+
+  AC_MSG_CHECKING([whether linker accepts -Wl,-z,noexecstack])
+  LDFLAGS="$save_LDFLAGS -Wl,-z,noexecstack"
+  AC_LINK_IFELSE([AC_LANG_PROGRAM()],
+    [SECURITY_LDFLAGS="$SECURITY_LDFLAGS -Wl,-z,noexecstack"
+     AC_MSG_RESULT([yes])],
+    [AC_MSG_RESULT([no])])
+
+  CFLAGS="$save_CFLAGS"
+  LDFLAGS="$save_LDFLAGS"
+])
+AC_MSG_NOTICE([Security CFLAGS : $SECURITY_CFLAGS])
+AC_MSG_NOTICE([Security LDFLAGS: $SECURITY_LDFLAGS])
