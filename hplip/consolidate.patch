+def clean_exit(code=0, waitTerminal=True):
+    if not NOTIFY and not CHECKING_ONLY and not IS_QUIET_MODE:
+        log.info("")
+        log.info("Done.")
+    change_spinner_state(True)
+    mod.unlockInstance()
+    hold_terminal()
