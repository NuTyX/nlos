+def hold_terminal():
+    if DONOT_CLOSE_TERMINAL:
+        log.info("\n\nPlease close this terminal manually. ")
+        try:
+            while 1:
+                pass
+        except KeyboardInterrupt:
+            pass
+
+
+def usage(typ='text'):
+    if typ == 'text':
+        utils.log_title(__title__, __version__)
+
+    utils.format_text(USAGE, typ, __title__, __mod__, __version__)
+    hold_terminal()
+    sys.exit(0)
