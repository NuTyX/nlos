+	@:
+$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am $(srcdir)/foomatic_drv.inc $(srcdir)/unreleased.inc $(srcdir)/cups_drv.inc $(srcdir)/class_cups_drv.inc $(am__configure_deps)
+	@for dep in $?; do \
