+                'deviceid'         : self.raw_deviceID,
+                'panel'            : 0,
+                'panel-line1'      : '',
+                'panel-line2'      : '',
+                'device-state'     : self.device_state,
+                'error-state'      : self.error_state,
+                })
+
+            status_block = {}
+
+            if status_type == STATUS_TYPE_NONE:
+                log.warn("No status available for device.")
