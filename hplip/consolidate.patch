+static struct bb_ledm_session* create_session()
+{
+  struct bb_ledm_session* pbb;
+
+  if ((pbb = malloc(sizeof(struct bb_ledm_session))) == NULL)
+  {
+    return NULL;
+  }
+
+  memset(pbb, 0, sizeof(struct bb_ledm_session));
+  return pbb;
+} /* create_session */
