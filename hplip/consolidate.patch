+                result_code, channel_id = hpmudext.open_channel(self.device_id, service_name)
+
+                self.channels[service_name] = channel_id
+                log.debug("channel-id=%d" % channel_id)
+                return channel_id
+            else:
+                return self.channels[service_name]
+        else:
+            return -1
