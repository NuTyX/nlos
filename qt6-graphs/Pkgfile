description='Qt Graphs for data visualization.'
url='https://www.qt.io/'

packager="tnut <tnut@nutyx.org>"
contributors="Spiky"

makedepends=(git qt6-base qt6-declarative qt6-quick3d
             qt6-shadertools)

set=(qt6)

name=qt6-graphs
version=6.12.0
release=1

_name=${name/6-/}-everywhere-src

source=(
https://download.qt.io/official_releases/qt/${version:0:4}/$version/submodules/${_name}-$version.tar.xz)

build() {
 cmake -S ${_name}-$version -B build -G Ninja
 cmake --build build
 DESTDIR=$PKG cmake --install build
}
