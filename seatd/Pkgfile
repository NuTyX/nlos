description="A minimal seat management daemon, and a universal seat management library"
url="https://git.sr.ht/~kennylevinsen/seatd/"

license="MIT"

packager="tnut <tnut@nutyx.org>"
contributors="BlogofraisFR,Spiky"

makedepends=(meson python systemd)

name=seatd
version=0.9.3
release=2

PKGMK_KEEP_SOURCES="no"

source=(https://git.sr.ht/~kennylevinsen/$name/archive/$version.tar.gz)

PKGMK_MESON_OPTIONS="-Dserver=enabled -Dlibseat-logind=systemd"
build=meson
package() {
 install -Dm644 $name-$version/LICENSE \
 $PKG/usr/share/licenses/$name/LICENSE
}
